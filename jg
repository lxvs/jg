#!/bin/sh
# SC1007: Allow space after variable=
# SC3043: Allow local at it is supported on most shells
# shellcheck disable=SC1007,SC3043

set -o nounset

reset_x ()
{
    printf "%s" "$opt" | grep -q 'x' && set -x
}

set_color ()
{
    set +x
    test -t 1 || return
    case $1 in
    red)
        printf "[91m"
        ;;
    green)
        printf "[92m"
        ;;
    yellow)
        printf "[93m"
        ;;
    *)
        ;;
    esac
}

reset_color ()
{
    test -t 1 || { reset_x; return; }
    printf "[0m"
    reset_x
    return 0
}

die ()
{
    set_color >&2 red
    while test $# -ge 1
    do
        printf >&2 "%s\n" "$1"
        shift
    done
    reset_color >&2
    exit 1
}

ParseSwitchValue ()
{
    test "$#" -ge 2 ||
        die "error: \`$1' requires a value"
    printf "%s" "$2"
}

Usage ()
{
cat <<\EOF
usage: jg <command> [<argument> ...]
   or: jg -h | --help
   or: jg -V | --version

commands:
    batch       Execute a command for each repo in current directory
    fixup       Fixup a commit and auto squashing rebase it non-interactively
    ls-files    List all files, including initialized submodules by default

    gh-help         Show help on the prerequisites to use below commands
    gh-create-repo  Create a public or private GitHub repository
    gh-delete-repo  Delete a GitHub repository

Use `jg <command> --help' for detailed usage on the specific command.
EOF
}

Logo ()
{
cat <<EOF

    jg $version
    $website

EOF
}

batchUsage ()
{
cat <<EOF
usage: jg batch [<options>] [--] <command> [<command-args> ...]

    -f, --force         Do not break when error
    -r, --recursive     Recurse into subderectories
    -s, --submodule     Include submodules
    --maxdepth N        Descend at most N (a non-negative integer) levels of
                        directories; implies --recursive
    --mindepth N        Skip at levels less than N (a non-negative integer);
                        implies --recursive
    --color[=<when>]    Show colored output. \`--color' is the same as
                        \`--color=always'. <when> can be one of \`always',
                        \`never', or \`auto'.
    --no-color          Disable color output (same as \`--color=never')

Execute the specified command for each repository in current directory.
EOF
}

batchOp ()
{
    local force= recursive= submodule= maxdepth= mindepth= deptharg= typearg=
    local color=auto cpre= csuf=
    local stop_parsing=
    for x in "$@"; do
        case $x,$stop_parsing in
        --help,)
            "$op"Usage
            return
            ;;
        --force,)
            force=1
            shift
            ;;
        --recursive,)
            recursive=1
            shift
            ;;
        --submodule,|--submodules,|--sub-module,|--sub-modules,)
            submodule=1
            shift
            ;;
        --maxdepth,)
            maxdepth=$2
            shift 2
            ;;
        --maxdepth=*,)
            maxdepth=${x#*=}
            shift
            ;;
        --mindepth,)
            mindepth=$2
            shift 2
            ;;
        --mindepth=*,)
            mindepth=${x#*=}
            shift
            ;;
        --color,)
            color=always
            shift
            ;;
        --color=*,)
            color=${x#*=}
            shift
            ;;
        --no-color,)
            color=never
            shift
            ;;
        --,)
            stop_parsing=1
            shift
            ;;
        --*,)
            die "error: unknown flag: $x"
            ;;
        -*,)
            flags=${x#-}
            while test "$flags"
            do
                flag=$(printf "%s" "$flags" | cut -b1)
                case $flag in
                h)
                    "$op"Usage
                    return
                    ;;
                f)
                    force=1
                    ;;
                r)
                    recursive=1
                    ;;
                s)
                    submodule=1
                    ;;
                *)
                    die "error: unknown flag: $flag"
                    ;;
                esac
                flags=${flags#"$flag"}
            done
            shift
            ;;
        *,*)
            set -- "$@" "$x"
            shift
            ;;
        esac
    done

    if ! { test "$recursive" || test "$maxdepth" || test "$mindepth"; }; then
        maxdepth=2
        mindepth=2
    fi

    if test "$maxdepth"; then
        is_digit "$maxdepth" || die "error: \`--maxdepth' requires a non-negative integer value, got: $maxdepth"
        deptharg="$deptharg-maxdepth $maxdepth "
    fi
    if test "$mindepth"; then
        is_digit "$mindepth" || die "error: \`--mindepth' requires a non-negative integer value, got: $mindepth"
        deptharg="$deptharg-mindepth $mindepth "
    fi
    test "$submodule" || typearg="-type d"
    case $color in
        ''|always)
            cpre='[93m'
            csuf='[0m'
            ;;
        never)
            cpre=''
            csuf=''
            ;;
        auto)
            if ! test -t 1
            then
                cpre=''
                csuf=''
            else
                cpre='[93m'
                csuf='[0m'
            fi
            ;;
        *)
            die "error: invalid --color option: $color"
            ;;
    esac

    # shellcheck disable=SC2016,SC2048,SC2086
    if test $# -gt 0; then
        if test $# -eq 1; then
            set -- ! -execdir "$SHELL" -c -- "$1" ';'
        else
            set -- ! -execdir "$SHELL" -c -- '"$0" "$@"' "$@" ';'
        fi

        test "$force" || set -- "$@" -printf 'exit code not 0, stop\n' -quit
    fi


    # shellcheck disable=SC2086,SC2067
    find . $deptharg -name .git ! -path '*/.git/*' $typearg -printf "$cpre%h$csuf\n" "$@"
}

is_digit()
{
    case $1 in
    ''|*[!0-9]*)
        return 1
        ;;
    *)
        return 0
        ;;
    esac
}

fixupUsage ()
{
cat <<EOF
usage: jg fixup [-b|--no-rebase] <commit> [<options>]

    -b, --no-rebase     Fixup only; do not rebase

It is equivalent to

    git commit --fixup=<commit> [<options>]

and then (unless -b or --no-rebase is specified)

    git rebase --interactive --autosquash --autostash --update-refs <commit>~2

and the editor won't pop out.

EOF
}

fixupOp ()
{
    local commit= n= commit_hash=
    for arg in "$@"; do
        case $arg in
            -h|--help)
                "$op"Usage
                return
                ;;
            -b|--no-rebase)
                n=1
                shift
                ;;
            --*)
                set -- "$@" "$arg"
                shift
                ;;
            -*)
                flags=${arg#-}
                flags_out=
                while test "$flags"; do
                    flag=$(printf "%s" "$flags" | cut -b1)
                    flags=${flags#"$flag"}
                    case $flag in
                        b)
                            n=1
                            ;;
                        *)
                            flags_out="${flags_out}${flag}"
                            ;;
                    esac
                done
                set -- "$@" "-$flags_out"
                shift
                ;;
            *)
                if test "$commit"; then
                    set -- "$@" "$arg"
                else
                    commit=$arg
                fi
                shift
                ;;
        esac
    done

    fixupOp_validate
    git commit --fixup="$commit" "$@" || return
    test "$n" && return
    git -c sequence.editor=: \
        -c rebase.updateRefs=true \
        rebase --interactive --autosquash --autostash "$commit_hash~1"
}

fixupOp_validate ()
{
    test "$commit" || die "error: <commit> not speficied"
    git rev-parse --verify --quiet --no-revs --end-of-options "$commit^2" &&
        die "error: cannot fixup a merge"
    commit_hash=$(git rev-parse --verify --end-of-options "$commit") ||
        die "error: invalid revision: $commit"
}

ls_filesUsage ()
{
cat <<EOF
usage: jg ls-files [<options>]

List files tracked by git.

Options:
    --recurse-submodules        Recursively calls ls-files on each active
                                submodule in the repository.  This is the
                                default when file \`.gitmodules' exists in root
                                directory.
    --no-recurse-submodules     Disable --recurse-submodules.
    -w, --worktree-attributes   Do not list files marked as export-ignore.
    --no-worktree-attributes    Disable -w.  This is the default.
    --sparse                    Do not include sparse files.  This is the
                                default when the index is sparse.
    -a, --no-sparse             Disable --sparse.
    -z                          \\0 line termination on output and do not quote
                                filenames.
EOF
}

ls_filesOp ()
{
    local toplevel= z= r= w= a=
    for arg in "$@"; do
        case $arg in
            -h|--help)
                "$op"Usage
                return
                ;;
            --recurse-submodules)
                r=--recurse-submodules
                ;;
            --no-recurse-submodules)
                r=--no-recurse-submodules
                ;;
            -w|--worktree-attributes)
                w=1
                ;;
            --no-worktree-attributes)
                w=
                ;;
            -a|--sparse)
                a=1
                ;;
            --no-sparse)
                a=
                ;;
            -z)
                z=-z
                ;;
            --)
                ;;
            --*)
                die "error: invalid argument: $arg"
                ;;
            -*)
                flags=${arg#-}
                while test "$flags"; do
                    flag=$(printf "%s" "$flags" | cut -b1)
                    case $flag in
                        h)
                            "$op"Usage
                            return
                            ;;
                        w)
                            w=1
                            ;;
                        a)
                            a=1
                            ;;
                        z)
                            z=-z
                            ;;
                        *)
                            die "error: unknown flag: $flag"
                            ;;
                    esac
                    flags=${flags#"$flag"}
                done
                ;;
            *)
                die "error: invalid argument: $arg"
                ;;
        esac
        shift
    done
    toplevel=$(git rev-parse --show-toplevel) || return
    test ! "$r" && test -e "$toplevel/.gitmodules" && r=--recurse-submodules
    if test "$a" || ! test -e "$toplevel/.git/info/sparse-checkout"; then
        if test "$w" && git ls-files $r | grep -q '\(^\|/\)\.gitattributes$'; then
            if test "$z"; then
                git ls-files -z $r \
                    | tr '\0' '\n' \
                    | git -c core.quotePath=false check-attr --stdin export-ignore \
                    | grep -v ': set$' \
                    | cut -d':' -f1 \
                    | tr '\n' '\0'
            else
                git ls-files $r \
                    | git check-attr --stdin export-ignore \
                    | grep -v ': set$' \
                    | cut -d':' -f1
            fi
        else
            git ls-files $z $r
        fi
    else
        if test "$w" && git ls-files $r | grep -q '\(^\|/\)\.gitattributes$'; then
            if test "$z"; then
                git ls-files -z -t $r \
                    | grep -z '^H ' \
                    | cut -z -d' ' -f2- \
                    | tr '\0' '\n' \
                    | git -c core.quotePath=false check-attr --stdin export-ignore \
                    | grep -v ': set$' \
                    | cut -d':' -f1 \
                    | tr '\n' '\0'
            else
                git ls-files -t $r \
                    | grep '^H ' \
                    | cut -d' ' -f2- \
                    | git check-attr --stdin export-ignore \
                    | grep -v ': set$' \
                    | cut -d':' -f1
            fi
        else
            git ls-files $z -t $r \
                | grep $z '^H ' \
                | cut $z -d' ' -f2-
        fi
    fi
}

gh_helpOp ()
{
cat <<EOF
To use \`For GitHub' commands like \`gh-create-repo', first you need to create
a personal access token.

 * Open github.com and login to your account.
 * Navigate to GitHub Settings -> Developer settings -> Personal access tokens
   -> Fine-grained personal access tokens.
 * Click \`Generate new token'.
 * In \`Repository access' section, either \`All repositories' or \`Only select
   repositories' needs to be selected.
 * Set Repository permissions -> Administration to \`Read and Write'.
 * Click \`Generate token' at the bottom of the page.
 * Copy the generated token.  Once you leave the page, you cannot see it again.
EOF
}

ghcrUsage ()
{
    gh_create_repoUsage
}

ghcrOp ()
{
    gh_create_repoOp "$@"
}

gh_create_repoUsage ()
{
cat <<EOF
usage: jg gh-create-repo [<options>] <name>

options:
    -t, --token <token>         GitHub personal access token
    -p, --private               Create a private repo instead

Create a public (or private, if specified so) GitHub repository with given name.
Note that the name of repository can only contain letters, digits, dashes (-),
dots (.) and underscores (_).

If not specified, <token> will be read from environment variable JG_GH_TOKEN.

Try \`jg gh-help' for more information on GitHub personal access token.
EOF
}

gh_create_repoOp ()
{
    local token= name=
    local private
    gh_create_repoOp_parse "$@"
    gh_create_repoOp_validate
    curl -L -s -X POST \
        -H "Accept: application/vnd.github+json" \
        -H "Authorization: Bearer $token" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        https://api.github.com/user/repos \
        -d "{\"name\": \"$name\"${private:+, \"private\": true}}"
}

gh_create_repoOp_parse ()
{
    while test $# -ge 1
    do
        case $1 in
        -h|--help)
            "$op"Usage
            exit
            ;;
        -t|--token)
            token=$(ParseSwitchValue "$@")
            shift 2
            ;;
        -p|--private)
            private=1
            shift
            ;;
        *)
            test "$name" &&
                die "error: invalid argument \`$1'"
            name=$1
            shift
            ;;
        esac
    done
}

gh_create_repoOp_validate ()
{
    test "$name" ||
        die "error: Repo name is required."
    test "$(printf "%s" "$name" | tr -d '[:alnum:]\-_.')" &&
        die "error: Repo name can only contain letters, digits, \`-', \`.' and \`_'."
    validate_gh_token
}

validate_gh_token ()
{
    test "$token" ||
        token=${JG_GH_TOKEN-}
    test "$token" ||
        die "error: either provide --token, or set environment variable JG_GH_TOKEN"
}

gh_delete_repoUsage ()
{
cat <<EOF
usage: jg gh-delete-repo [<options>] <owner>/<repo>

options:
    -t, --token <token>         GitHub personal access token

Delete a GitHub repository PERMANENTLY, WITHOUT CONFIRMATION.  It cannot be
undone, so USE WITH GREAT CAUTION!

If not specified, <token> will be read from environment variable JG_GH_TOKEN.

Try \`jg gh-help' for more information on GitHub personal access token.
EOF
}

gh_delete_repoOp ()
{
    local owner_slash_repo= token=
    gh_delete_repoOp_parse "$@"
    gh_delete_repoOp_validate
    curl -Ls \
        -X DELETE \
        -H "Accept: application/vnd.github+json" \
        -H "Authorization: Bearer $token" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "https://api.github.com/repos/$owner_slash_repo"
}

gh_delete_repoOp_parse ()
{
    while test $# -ge 1
    do
        case $1 in
        -h|--help)
            "$op"Usage
            exit
            ;;
        -t|--token)
            token=$(ParseSwitchValue "$@")
            shift 2
            ;;
        *)
            test "$owner_slash_repo" &&
                die "error: invalid argument \`$1'"
            owner_slash_repo=$1
            shift
            ;;
        esac
    done
}

gh_delete_repoOp_validate ()
{
    test "$owner_slash_repo" ||
        die "error: owner and repo is required."
    test "$(printf "%s" "$owner_slash_repo" | tr -dc '/')" ||
        die "error: please provide owner and repo as \`OWNER/REPO'"
    validate_gh_token
}

ParseArgs ()
{
    local op
    if test $# -eq 0
    then
        Logo
        Usage
        return
    fi
    case $1 in
    -V|--version)
        Logo
        exit
        ;;
    -h|--help)
        Logo
        Usage
        exit
        ;;
    batch|fixup|ghcr)
        op=$1
        shift
        "$op"Op "$@"
        return
        ;;
    ls-files|gh-help|gh-create-repo|gh-delete-repo)
        op=$(printf "%s" "$1" | tr '-' '_')
        shift
        "$op"Op "$@"
        return
        ;;
    *)
        die "error: invalid argument \`$1'" \
            "Try \`jg --help' for more information."
        ;;
    esac
}

main ()
{
    set +x
    local version="2.13.0"
    local website="https://github.com/lxvs/jg"
    local JG_GH_USER="${JG_GH_USER-}"
    reset_x
    ParseArgs "$@" || return
}

opt=$-

main "$@"
